# Copy to .env and fill in. Never commit .env.
# SEC requires "First Last email" as User-Agent for EDGAR requests.
SEC_USER_AGENT=
# Only needed when prices.source = tiingo
TIINGO_API_KEY=
# cpu (default) or cuda
PIQ_COMPUTE=cpu
# Optional: extra pip requirements installed in the Airflow container
PIQ_PIP_REQUIREMENTS=
